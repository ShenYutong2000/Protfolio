{
  "name": "interactive-study-portfolio",
  "version": "1.0.0",
  "description": "This is my personal protfolio",
  "scripts": {
    "build:portfolio": "npm run build --workspace @portfolio/template",
    "predev": "npm run build:portfolio",
    "prebuild": "npm run build:portfolio",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:study-model": "node scripts/check-study-model.mjs",
    "check:study-loading": "node --test scripts/check-study-loading.mjs",
    "optimize:study-model": "gltf-transform optimize --simplify-ratio 0.08 --simplify-error 0.01 --simplify-lock-border false --texture-size 512 --texture-compress webp --compress meshopt --flatten true --join true --prune true --prune-attributes true --resample true --weld true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShenYutong2000/Protfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "workspaces": ["vendor/portfolio-template"],
  "bugs": {
    "url": "https://github.com/ShenYutong2000/Protfolio/issues"
  },
  "homepage": "https://github.com/ShenYutong2000/Protfolio#readme",
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
